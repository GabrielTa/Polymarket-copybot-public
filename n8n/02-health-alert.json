{
  "name": "Polybot \u2014 Health Alert",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "13 */6 * * *"
            }
          ]
        }
      },
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://YOUR_SERVER_IP:8000/api/digest?window=48h",
        "options": {}
      },
      "name": "Get Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.alert_count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "name": "Any alerts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst d = $json;\nif (!d.alerts || d.alerts.length === 0) return [];\nconst icon = d.status === 'critical' ? '\ud83d\udea8' : '\u26a0\ufe0f';\nlet msg = `${icon} *Polybot alert* (${d.strategy_version})\\n\\n`;\nmsg += d.alerts.map(a => `*${a.code}*\\n${a.message}`).join('\\n\\n');\nmsg += `\\n\\nEquity $${d.equity.current.toLocaleString()} \u00b7 drawdown ${d.equity.drawdown_pct}%`;\nreturn [{ json: { text: msg } }];\n"
      },
      "name": "Format Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        240
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        1120,
        240
      ]
    }
  ],
  "connections": {
    "Every 6 hours": {
      "main": [
        [
          {
            "node": "Get Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Digest": {
      "main": [
        [
          {
            "node": "Any alerts?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any alerts?": {
      "main": [
        [
          {
            "node": "Format Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Alert": {
      "main": [
        [
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}